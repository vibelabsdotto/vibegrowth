{
  "name": "vibegrowth",
  "version": "0.0.1",
  "private": true,
  "description": "Lokales Growth-Studio für alle VibeLabs-Projekte: Shortform (Kalender, Formate, Regeln, Posts, Zahlen) und Website-/App-Growth (Funnel, Collector, Content-Pipeline, Experimente, GEO, Stores) in SQLite, bedienbar per Web-App und CLI.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"apps/*/{src,app,components,hooks,lib}/**/*.{ts,tsx}\"",
    "dev:api": "VIBEGROWTH_API_PORT=${VIBEGROWTH_API_PORT:-4311} npm run start:dev --workspace apps/api",
    "dev:web": "VIBEGROWTH_API_URL=${VIBEGROWTH_API_URL:-http://127.0.0.1:4311} npm run dev --workspace apps/web",
    "db:generate": "npm run db:generate --workspace apps/api"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
