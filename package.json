{
  "name": "vibegrowth",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "npm run build:cli && next build",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --packages=external",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "cli": "tsx cli/index.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "Lokales Growth-Studio für alle VibeLabs-Projekte: Shortform (Kalender, Formate, Regeln, Posts, Zahlen) und Website-/App-Growth (Funnel, Collector, Content-Pipeline, Experimente, GEO, Stores) in SQLite, bedienbar per Web-App und CLI.",
  "license": "MIT",
  "bin": {
    "vibegrowth": "bin/vibegrowth.mjs",
    "vibeshorts": "bin/vibeshorts.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
